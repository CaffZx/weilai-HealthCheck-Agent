from scripts.submit_real_patrol_to_control_center import _apply_operating_modes
from scripts.submit_real_patrol_to_control_center import build_request
from scripts.submit_real_patrol_to_control_center import EmptySubmittablePayload


@dataclass(frozen=True, slots=True)
class PatrolEvidence:
    parent_asin: str
    shop_id: int
    site_code: str
    parent_seller_sku: str
    job_id: str
    job_status: str
    run_id: str | None
    run_status: str | None
    raw_fact_count: int
    raw_fact_success_count: int
    snapshot_count: int
    occurrence_count: int
    outbox_status: str | None
    error_code: str | None


def _require_delivery_runtime() -> None:
    settings = load_settings()
    stage = str(settings.get("rollout", {}).get("stage", "")).upper()
    if stage not in {"CANARY", "FULL"}:
        raise RuntimeError("batch patrol delivery requires rollout.stage=CANARY or FULL")
    flags = settings.get("feature_flags", {}) or {}
    if not flags.get("control_center_delivery_enabled"):
        raise RuntimeError("control center delivery must be enabled")


async def _deliver_to_control_center(batch_id: str, unit_count: int) -> list[str]:
    publisher = get_control_center_batch_publisher()
    with get_database_engine().connect() as connection:
        source_rows = connection.execute(
            text(
                """
                SELECT parent_asin, shop_id, parent_seller_sku, status, result_ref
                FROM (
                    SELECT j.parent_asin, j.shop_id, j.parent_seller_sku,
                           j.status, j.result_ref,
                           ROW_NUMBER() OVER (
                               PARTITION BY j.shop_id, j.parent_asin, j.parent_seller_sku
                               ORDER BY j.created_at DESC, j.job_id DESC
                           ) AS rank_no
                    FROM t_patrol_job j
                    WHERE j.batch_id=:batch_id
                ) latest
                WHERE rank_no=1
                """
            ),
            {"batch_id": batch_id},
        ).mappings().all()
    source_count = len(source_rows)
    successful_count = sum(
        row["status"] == "SUCCEEDED" and row["result_ref"] is not None
        for row in source_rows
    )
    if successful_count == 0:
        raise RuntimeError(
            f"no successful patrol snapshots available for batch {batch_id}"
        )
    outbox_ids: list[str] = []
    outbox_unit_counts: dict[str, int] = {}
    skipped_count = 0
    for offset in range(0, successful_count, 50):
        part = offset // 50 + 1
        part_size = min(50, successful_count - offset)
        request = build_request(
            f"{batch_id}-P{part}",
            source_batch_ids=[batch_id],
            expected_count=source_count,
            probe=False,
            offset=offset,
            limit=part_size,
            skip_unsubmittable=True,
            operating_modes=None,
        )
        request = await _apply_operating_modes(request)
        submitted_count = len(request.units)
        skipped_count += part_size - submitted_count
        outbox_id = await publisher.enqueue(request)
        outbox_ids.append(outbox_id)
        outbox_unit_counts[outbox_id] = submitted_count
        print(
            f"control-center prepared batch={batch_id} part={part} "
            f"inspected={part_size} submitted={submitted_count} "
            f"skipped={part_size - submitted_count} outbox={outbox_id}",
            flush=True,
        )

    settings = load_settings()
    delivery = settings.get("delivery", {}) or {}
    worker_settings = settings.get("worker", {}) or {}
    attempt_timeout = float(
        (settings.get("worker", {}) or {}).get("delivery_attempt_timeout_seconds", 60)
    )
    worker = MySqlControlCenterDeliveryWorker(
        engine=get_database_engine(),
        client=get_control_center_mcp_client(),
        worker_id=f"batch-delivery:{batch_id}",
        base_backoff_seconds=int(delivery.get("base_backoff_seconds", 30)),
        rollout_policy=RolloutPolicy(stage=str(settings["rollout"]["stage"])),
        allowed_outbox_ids=frozenset(outbox_ids),
        request_timeout_seconds=attempt_timeout,
    )
    delivery_timeout = float(worker_settings.get("batch_timeout_seconds", 10800))
    if delivery_timeout <= 0:
        raise ValueError("worker.batch_timeout_seconds must be positive")
    deadline = datetime.now(UTC).timestamp() + delivery_timeout
    pending = set(outbox_ids)
    while pending and datetime.now(UTC).timestamp() < deadline:
        result = await worker.process_once()
        with get_database_engine().connect() as connection:
            rows = connection.execute(
                sa.select(
                    patrol_delivery_outbox.c.outbox_id,
                    patrol_delivery_outbox.c.status,
                    patrol_delivery_outbox.c.last_error,
                ).where(patrol_delivery_outbox.c.outbox_id.in_(pending))
            ).mappings().all()
        for row in rows:
            if row["status"] == DeliveryStatus.DELIVERED.value:
                pending.discard(row["outbox_id"])
                print(
                    f"control-center delivered batch={batch_id} "
                    f"outbox={row['outbox_id']} "
                    f"submitted={outbox_unit_counts.get(row['outbox_id'], 0)}"
                )
            elif row["status"] == DeliveryStatus.DEAD.value:
                print(
                    f"control-center delivery failed outbox={row['outbox_id']} "
                    f"error={row['last_error']}; continuing",
                    flush=True,
                )
        if pending:
            next_wait = 2.0
            if result.outbox_id is not None and result.status is DeliveryStatus.PENDING:
                next_wait = min(
                    60.0,
                    float(delivery.get("base_backoff_seconds", 30))
                    * (2 ** max(0, result.retry_count - 1)),
                )
            remaining = deadline - datetime.now(UTC).timestamp()
            if remaining <= 0:
                break
            await asyncio.sleep(min(next_wait, remaining))
    if pending:
        raise TimeoutError(
            f"control-center delivery did not receive ACK for {len(pending)} batches"
        )
    print(
        f"control-center summary batch={batch_id} inspected={unit_count} "
        f"submitted={sum(outbox_unit_counts.values())} skipped={skipped_count} "
        f"delivered_parts={len(outbox_ids)}",
        flush=True,
    )
    return outbox_ids


async def _candidate_bindings() -> list[OperatingUnitBinding]:
    return await get_operating_unit_provider().list_all_active_units()


def _explicit_bindings(path: Path) -> list[OperatingUnitBinding]:
    payload = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(payload, list) or not payload:
        raise ValueError("units file must contain a non-empty JSON array")
    bindings: list[OperatingUnitBinding] = []
    operating_unit_ids: set[str] = set()
    for index, item in enumerate(payload):
        if not isinstance(item, dict):
            raise ValueError(f"units file item {index} must be an object")
        binding = OperatingUnitBinding(
            shop_id=item.get("shopId"),
            shop_account=item.get("shopAccount"),
            site_code=item.get("siteCode"),
            parent_asin=item.get("parentAsin"),
            parent_seller_sku=item.get("parentSellerSku"),
        )
        if binding.operating_unit_id in operating_unit_ids:
            raise ValueError(f"duplicate operating unit at item {index}")
        operating_unit_ids.add(binding.operating_unit_id)
        bindings.append(binding)
    return bindings


async def _select_live_units(
    candidates: list[OperatingUnitBinding],
    count: int,
) -> tuple[list[OperatingUnitBinding], list[tuple[str, str]]]:
    collector = FactCollector(get_mcp_client())
    selected: list[OperatingUnitBinding] = []
    rejected: list[tuple[str, str]] = []
    async def validate(candidate: OperatingUnitBinding):
        tool_name, arguments = collector.build_calls(candidate, date.today())["product_info"]
        error: Exception | None = None
        for attempt in range(3):
            try:
                result = await get_mcp_client().call_tool(tool_name, arguments)
                require_fact_contract(candidate, {"product_info": result})
                if not result.data:
                    raise RuntimeError("product_info returned no rows")
                return candidate, None
            except Exception as exc:
                error = exc
                if attempt < 2:
                    await asyncio.sleep(attempt + 1)
        return candidate, type(error).__name__ if error else "UnknownError"

    for offset in range(0, len(candidates), 24):
        results = await asyncio.gather(
            *(validate(candidate) for candidate in candidates[offset : offset + 24])
        )
        for candidate, error in results:
            if error:
                rejected.append((candidate.parent_asin, error))
                continue
            selected.append(candidate)
            print(
                f"selected {len(selected):03d}/{count} asin={candidate.parent_asin} "
                f"shopId={candidate.shop_id} site={candidate.site_code} "
                f"parentSku={candidate.parent_seller_sku}"
            )
            if len(selected) == count:
                return selected, rejected
    return selected, rejected


def _evidence(batch_id: str) -> list[PatrolEvidence]:
    engine = get_database_engine()
    with engine.connect() as connection:
        rows = connection.execute(
            text(
                """
                SELECT j.parent_asin,j.shop_id,j.site_code,j.parent_seller_sku,j.job_id,
                       j.status AS job_status,j.result_ref,j.last_error_code,
                       r.status AS run_status,
                       (SELECT COUNT(*) FROM t_patrol_raw_fact rf
                        WHERE rf.run_id=j.result_ref) AS raw_fact_count,
                       (SELECT COUNT(*) FROM t_patrol_raw_fact rf
                        WHERE rf.run_id=j.result_ref AND rf.status='SUCCESS') AS raw_fact_success_count,
                       (SELECT COUNT(*) FROM t_patrol_fact_snapshot fs
                        WHERE fs.run_id=j.result_ref) AS snapshot_count,
                       (SELECT COUNT(*) FROM t_patrol_signal_occurrence so
                        WHERE so.run_id=j.result_ref) AS occurrence_count,
                       (SELECT o.status FROM t_patrol_delivery_outbox o
                        WHERE o.aggregate_id=j.result_ref LIMIT 1) AS outbox_status
                FROM t_patrol_job j
                LEFT JOIN t_patrol_run r ON r.run_id=j.result_ref
                WHERE j.batch_id=:batch_id
                ORDER BY j.parent_asin,j.shop_id
                """
            ),
            {"batch_id": batch_id},
        ).mappings().all()
    return [
        PatrolEvidence(
            parent_asin=row["parent_asin"],
            shop_id=int(row["shop_id"]),
            site_code=row["site_code"],
            parent_seller_sku=row["parent_seller_sku"],
            job_id=row["job_id"],
            job_status=row["job_status"],
            run_id=row["result_ref"],
            run_status=row["run_status"],
            raw_fact_count=int(row["raw_fact_count"]),
            raw_fact_success_count=int(row["raw_fact_success_count"]),
            snapshot_count=int(row["snapshot_count"]),
            occurrence_count=int(row["occurrence_count"]),
            outbox_status=row["outbox_status"],
            error_code=row["last_error_code"],
        )
        for row in rows
    ]


async def run(
    count: int | None,
    candidate_limit: int,
    concurrency: int,
    skip_live_precheck: bool,
    units_file: Path | None = None,
    all_active: bool = False,
    start_offset: int = 0,
) -> int:
    if all_active and units_file is None:
        candidates = await _candidate_bindings()
        candidates = candidates[start_offset:]
        if not candidates:
            raise RuntimeError("operating-unit catalog contains no units after start offset")
        batch_size = 50
        failures: list[tuple[int, Exception]] = []
        total = len(candidates)
        for offset in range(0, total, batch_size):
            batch_candidates = candidates[offset : offset + batch_size]
            batch_number = offset // batch_size + 1
            print(
                f"starting batch={batch_number} offset={start_offset + offset} "
                f"units={len(batch_candidates)} total={total}",
                flush=True,
            )
            try:
                await _run_single_batch(
                    len(batch_candidates),
                    len(batch_candidates),
                    concurrency,
                    skip_live_precheck,
                    units_override=batch_candidates,
                    all_active=False,
                )
            except Exception as exc:
                failures.append((batch_number, exc))
                print(
                    f"batch_failed batch={batch_number} "
                    f"error={type(exc).__name__}: {exc}; continuing",
                    flush=True,
                )
        if failures:
            raise RuntimeError(
                f"full catalog patrol completed with failed_batches="
                f"{len(failures)}/{(total + batch_size - 1) // batch_size}"
            )
        return 0
    return await _run_single_batch(
        count,
        candidate_limit,
        concurrency,
        skip_live_precheck,
        units_file=units_file,
        all_active=all_active,
    )


async def _run_single_batch(
    count: int | None,
    candidate_limit: int,
    concurrency: int,
    skip_live_precheck: bool,
    units_file: Path | None = None,
    all_active: bool = False,
    units_override: list[OperatingUnitBinding] | None = None,
) -> int:
    _require_delivery_runtime()
    candidates = (
        units_override
        if units_override is not None
        else (_explicit_bindings(units_file) if units_file else await _candidate_bindings())
    )
    if all_active:
        count = len(candidates)
    elif count is None:
        raise ValueError("count is required unless --all-active is used")
    else:
        candidates = candidates[:candidate_limit]
    if not candidates:
        raise RuntimeError("operating-unit catalog contains no active units")
    if units_file and len(candidates) != count:
        raise RuntimeError(
            f"units file contains {len(candidates)} items but --count is {count}"
        )
    if skip_live_precheck:
        selected, rejected = candidates[:count], []
        print(f"selected {len(selected)}/{count} without live product-info precheck")
    else:
        selected, rejected = await _select_live_units(candidates, count)
    if len(selected) != count:
        print(
            f"only {len(selected)}/{count} live parent ASINs passed validation; "
            f"rejected={len(rejected)}; proceeding with {len(selected)}",
            flush=True,
        )

    token = uuid4().hex[:12]
    queue = get_runtime_queue()
    batch_id, created = queue.create_batch(
        trigger_type=TriggerType.MANUAL,
        business_date=date.today(),
        units=selected,
        rule_bundle_version="real-n-unit-v2",
        idempotency_key=f"REAL_{count}_UNIT:{date.today().isoformat()}:{token}",
        scope={
            "kind": "REAL_N_UNIT_PATROL",
            "request_id": f"real-{count}-unit-{token}",
            "trace_id": f"real-{count}-unit-trace-{token}",
            "initialization_ready": False,
            "external_delivery": "CONTROL_CENTER_REQUIRED",
            "selection_source": (
                "EXPLICIT_FILE_PLUS_LIVE_PRODUCT_INFO"
                if units_file
                else "WEEKLY_CATALOG_PLUS_LIVE_PRODUCT_INFO"
            ),
            "parent_asins": [unit.parent_asin for unit in selected],
            "operating_unit_ids": [unit.operating_unit_id for unit in selected],
        },
    )
    if not created:
        raise RuntimeError("real 20-ASIN batch unexpectedly already existed")
    print(f"created batch_id={batch_id} jobs={count}")

    async def patrol_handler(job):
        envelope = await get_runtime_orchestrator().run_job(job, as_of=date.today())
        return envelope.run.run_id

    settings = load_settings()
    rollout_settings = settings.get("rollout", {}) or {}
    rollout_stage = str(rollout_settings.get("stage", "")).upper()
    if rollout_stage not in {"CANARY", "FULL"}:
        raise RuntimeError(
            "batch patrol execution requires rollout.stage=CANARY or FULL"
        )
    rollout = RolloutPolicy(
        stage=rollout_stage,
        allowlisted_shop_ids=(
            sorted({unit.shop_id for unit in selected})
            if rollout_stage == "CANARY"
            else None
        ),
    )
    worker_settings = settings.get("worker", {}) or {}
    job_timeout = float(worker_settings.get("job_timeout_seconds", 900))
    batch_timeout = float(worker_settings.get("batch_timeout_seconds", 10800))
    deadline = datetime.now(UTC).timestamp() + batch_timeout

    async def drain(worker_number: int) -> None:
        worker = MySqlRuntimeWorker(
            queue=queue,
            worker_id=f"real-{count}-unit:{token}:{worker_number}",
            handlers={"patrol.run": patrol_handler},
            rollout_policy=rollout,
            allowed_batch_ids=frozenset({batch_id}),
            handler_timeout_seconds=job_timeout,
        )
        while datetime.now(UTC).timestamp() < deadline:
            batch = queue.get_batch(batch_id)
            if batch is None:
                raise RuntimeError("batch disappeared during execution")
            terminal = int(batch["succeeded_count"]) + int(batch["failed_count"])
            no_more = int(batch["pending_count"]) == 0 and int(batch["running_count"]) == 0
            if terminal == count or no_more:
                return
            result = await worker.process_once()
            if not result.processed:
                await asyncio.sleep(2)
        raise TimeoutError("real operating-unit batch exceeded three hours")

    workers = [asyncio.create_task(drain(index)) for index in range(concurrency)]
    try:
        async with asyncio.timeout(batch_timeout):
            while any(not task.done() for task in workers):
                failed_tasks = [
                    task for task in workers
                    if task.done() and not task.cancelled() and task.exception() is not None
                ]
                if failed_tasks:
                    raise failed_tasks[0].exception()  # type: ignore[misc]
                batch = queue.get_batch(batch_id)
                if batch is None:
                    raise RuntimeError("batch disappeared during execution")
                terminal = int(batch["succeeded_count"]) + int(batch["failed_count"])
                print(
                    f"progress batch={batch_id} terminal={terminal}/{count} "
                    f"pending={batch['pending_count']} running={batch['running_count']} "
                    f"succeeded={batch['succeeded_count']} failed={batch['failed_count']}"
                )
                no_more = int(batch["pending_count"]) == 0 and int(batch["running_count"]) == 0
                if terminal == count or no_more:
                    break
                remaining = deadline - datetime.now(UTC).timestamp()
                if remaining <= 0:
                    break
                await asyncio.sleep(min(10.0, remaining))
            await asyncio.gather(*workers)
    except BaseException:
        for task in workers:
            if not task.done():
                task.cancel()
        await asyncio.gather(*workers, return_exceptions=True)
        raise

    evidence = _evidence(batch_id)
    for item in evidence:
        print(
            f"result asin={item.parent_asin} shopId={item.shop_id} "
            f"job={item.job_status} run={item.run_status or '-'} "
            f"facts={item.raw_fact_success_count}/{item.raw_fact_count} "
            f"snapshot={item.snapshot_count} occurrences={item.occurrence_count} "
            f"outbox={item.outbox_status or '-'} error={item.error_code or '-'}"
        )
    succeeded = [item for item in evidence if item.job_status == JobStatus.SUCCEEDED.value]
    failed = [item for item in evidence if item.job_status != JobStatus.SUCCEEDED.value]
    if not succeeded:
        raise RuntimeError(
            f"patrol batch cannot be delivered: succeeded=0/{count}"
        )
    outbox_ids = await _deliver_to_control_center(batch_id, count)
    fully_persisted = [
        item
        for item in succeeded
        if item.raw_fact_count >= len(TOOL_NAMES)
        and item.raw_fact_success_count == item.raw_fact_count
        and item.snapshot_count == 1
    ]
    print(
        f"summary batch_id={batch_id} selected={len(selected)} rejected_candidates={len(rejected)} "
        f"succeeded={len(succeeded)} fully_persisted={len(fully_persisted)} "
        f"failed={len(failed)}"
        f" control_center_delivered={len(outbox_ids)}"
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="One-shot real patrol batch with MySQL evidence")
    parser.add_argument("--count", type=int)
    parser.add_argument("--candidate-limit", type=int, default=100)
    parser.add_argument("--concurrency", type=int, default=4)
    parser.add_argument("--skip-live-precheck", action="store_true")
    parser.add_argument(
        "--all-active",
        action="store_true",
        help="run every active operating unit from the weekly catalog",
    )
    parser.add_argument(
        "--start-offset",
        type=int,
        default=0,
        help="skip this many sorted catalog units when running --all-active",
    )
    parser.add_argument(
        "--units-file",
        type=Path,
        help="JSON array of explicit shop and parent-listing bindings",
    )
    args = parser.parse_args()
    if args.count is not None and (args.count < 1 or args.count > 10_000):
        raise SystemExit("count must be between 1 and 10000")
    if not args.all_active and args.count is None:
        raise SystemExit("--count is required unless --all-active is used")
    if args.count is not None and args.candidate_limit < args.count:
        raise SystemExit("candidate-limit must be at least count")
    if args.concurrency < 1 or args.concurrency > 8:
        raise SystemExit("concurrency must be between 1 and 8")
    if args.start_offset < 0:
        raise SystemExit("--start-offset must be non-negative")
    if args.start_offset and not args.all_active:
        raise SystemExit("--start-offset requires --all-active")
    return asyncio.run(
        run(
            args.count,
            args.candidate_limit,
            args.concurrency,
            args.skip_live_precheck,
            args.units_file,
            args.all_active,
            args.start_offset,
        )
    )


if __name__ == "__main__":
    raise SystemExit(main())
