    "advert_config": "MCP_ADVERT_CONFIG_UNAVAILABLE",
    "monthly_goal": "MCP_MONTHLY_GOAL_UNAVAILABLE",
    "refund_rate": "MCP_REFUND_RATE_UNAVAILABLE",
    "platform_activity": "MCP_PLATFORM_ACTIVITY_UNAVAILABLE",
