"""事实质量检查 —— 决定"阻断"还是"降级"。

改造方案 v1.0 §5.3 降级规则表的落地。

【判定原则】
  1. 核心工具失败 → blocking 缺口 → 整轮产出数据阻断包，不生成可审批建议。
  2. 非核心工具失败或返回空 → 非 blocking 缺口 → 降低完整度，主流程继续。
  3. 派生字段缺失（如库存可覆盖天数算不出）→ 非 blocking，但会让下游冲突检查
     显式报"无法判断"，而不是当作"没有风险"。
  4. 身份不完整 → IDENTITY_REQUIRED，blocking，且不得进入事件池。

【为什么不给默认值】
  交接包写死了"数据不足时输出观察类结果，绝不猜、绝不填默认值"。
  库存天数缺失当成 999 天、目标 ACOS 缺失当成行业均值，都会让经营建议
  建立在编造的事实上。缺口就是缺口，写清楚谁去补、补什么。
"""
from __future__ import annotations

import logging
from typing import Any

from clients.azlisting_contract import AZLISTING_EXTENSION_TOOL_NAMES
from clients.mcp_client import McpToolResult
from core.contracts import DataGap
from core.enums import DataQualityStatus
from core.operating_unit import OperatingUnitBinding
from facts.collector import CORE_KEYS, SUPPLEMENTAL_TOOL_NAMES, TOOL_NAMES

logger = logging.getLogger(__name__)

