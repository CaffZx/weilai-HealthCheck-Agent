EXTENSION_EMPTY_IS_UNAVAILABLE = frozenset({
    "child_detail",
    "price_promotion",
    "keyword_rank",
})


class FactQualityService:
    """检查采集与归一化结果，产出数据缺口清单。"""

    def __init__(self, *, sales_min_effective_days: int = 7) -> None:
        self.sales_min_effective_days = sales_min_effective_days

    def check(
        self,
        unit: OperatingUnitBinding,
        raw: dict[str, McpToolResult | Exception],
        normalized: dict[str, Any],
    ) -> list[DataGap]:
        disabled_fact_keys = frozenset(
            (normalized.get("_meta") or {}).get("disabled_fact_keys") or []
        )
        gaps: list[DataGap] = []
        gaps.extend(self._tool_gaps(raw, disabled_fact_keys))
        gaps.extend(self._supplemental_tool_gaps(raw, normalized))
        gaps.extend(self._extension_tool_gaps(raw))
        gaps.extend(self._identity_source_gaps(raw, normalized))
        gaps.extend(self._derived_gaps(normalized))
        gaps.extend(self._identity_gaps(unit, normalized))
        return _dedupe(gaps)

    # -- 工具级 ------------------------------------------------------------
    def _tool_gaps(
        self,
        raw: dict[str, McpToolResult | Exception],
        disabled_fact_keys: frozenset[str] = frozenset(),
    ) -> list[DataGap]:
        gaps: list[DataGap] = []
        for key in TOOL_NAMES:
            if key in disabled_fact_keys:
                continue
            result = raw.get(key)
            # listing_identity（erp_asin_full_detail，前台快照）：父体在亚马逊前台
            # 本就没有独立详情页（只有子体才有前台页），返回空/报错（ARGUMENT
            # CONTENT IS NULL）是上游语义，不作为数据缺口。前台相关的异常判断
            # 走 child_detail（子体前台），不依赖此父体字段。
            if key == "listing_identity":
                continue
            profile = GAP_PROFILES[key]
            blocking = key in CORE_KEYS

            if result is None or isinstance(result, Exception):
                reason = "未采集" if result is None else f"{type(result).__name__}"
                gaps.append(DataGap(
                    code=GAP_CODES[key],
                    field=profile["field"],
                    impact=f"{profile['impact']}（原因：{reason}）",
                    repair_action=profile["repair_action"],
                    blocking=blocking,
                    source_tool=TOOL_NAMES[key],
                ))
                continue

            if isinstance(result, McpToolResult) and result.is_empty:
                if key == "monthly_goal":
                    continue
                # 空结果对不同工具语义不同：库存告警为空是正常的，
                # 毛利历史为空则说明取不到销量事实。核心工具空 = 阻断。
                gaps.append(DataGap(
                    code=GAP_CODES[key],
                    field=profile["field"],
                    impact=f"{profile['impact']}（原因：返回空数据）",
                    repair_action=profile["repair_action"],
                    blocking=blocking and key in {"product_info", "gross_profit"},
                    source_tool=TOOL_NAMES[key],
                ))

        return gaps

    def _supplemental_tool_gaps(
        self,
        raw: dict[str, McpToolResult | Exception],
        normalized: dict[str, Any],
    ) -> list[DataGap]:
        gaps: list[DataGap] = []
        for key, profile in SUPPLEMENTAL_GAP_PROFILES.items():
            if key not in raw:
                continue
            quality = normalized.get("quality") or {}
            if quality.get("star_rating") is not None and quality.get("review_count") is not None:
                continue
            result = raw.get(key)
            if isinstance(result, Exception):
                reason = type(result).__name__
            elif isinstance(result, McpToolResult) and result.is_empty:
                reason = "返回空数据"
            elif isinstance(result, McpToolResult):
                reason = "响应缺少星级或评论数"
            else:
                continue
            gaps.append(DataGap(
                code=profile["code"],
                field=profile["field"],
                impact=f"{profile['impact']}（原因：{reason}）",
                repair_action=profile["repair_action"],
                blocking=False,
                source_tool=SUPPLEMENTAL_TOOL_NAMES[key],
            ))
        return gaps

    def _identity_source_gaps(
        self,
        raw: dict[str, McpToolResult | Exception],
        normalized: dict[str, Any],
    ) -> list[DataGap]:
        gaps: list[DataGap] = []
        if not (normalized.get("identity") or {}).get("own_seller_id"):
            gaps.append(DataGap(
                code="OWN_SELLER_ID_MISSING",
                field="identity.own_seller_id",
                impact="本店 Seller ID 为空，Buy Box 归属不可判",
                repair_action="补齐 erp_listing_product_info.SELLING_PARTNER_ID 后重跑巡检",
                blocking=False,
                source_tool=TOOL_NAMES["product_info"],
            ))
        return gaps

    def _extension_tool_gaps(
        self, raw: dict[str, McpToolResult | Exception]
    ) -> list[DataGap]:
        gaps: list[DataGap] = []
        for fact_key, result in raw.items():
            prefix, separator, child_asin = fact_key.partition(":")
            if not separator or prefix not in EXTENSION_GAP_PROFILES:
                continue
            profile = EXTENSION_GAP_PROFILES[prefix]
            reason: str | None = None
            if isinstance(result, Exception):
                reason = type(result).__name__
            elif isinstance(result, McpToolResult):
                if result.is_empty and prefix in EXTENSION_EMPTY_IS_UNAVAILABLE:
                    reason = "返回空数据"
                elif result.data:
                    response_asins = {
                        str(row.get("asin") or "").strip().upper()
                        for row in result.data
                        if isinstance(row, dict) and row.get("asin")
                    }
                    if response_asins and child_asin.upper() not in response_asins:
                        reason = "响应子 ASIN 与请求不一致"
            if reason is None:
                continue
            gaps.append(DataGap(
                code=profile["code"],
                field=f"{profile['field']}[{child_asin.upper()}]",
                impact=f"{profile['impact']}（子 ASIN {child_asin.upper()}；原因：{reason}）",
                repair_action=profile["repair_action"],
                blocking=False,
                source_tool=AZLISTING_EXTENSION_TOOL_NAMES[prefix],
            ))
        return gaps

    # -- 派生字段 ----------------------------------------------------------
    def _derived_gaps(self, normalized: dict[str, Any]) -> list[DataGap]:
        gaps: list[DataGap] = []
        sales = normalized.get("sales", {})
        inventory = normalized.get("inventory", {})
        profit = normalized.get("profit", {})
        traffic = normalized.get("traffic", {})

        if sales.get("monthly_target") is None:
            gaps.append(DataGap(
                code="MONTHLY_TARGET_CONFIG_MISSING",
                field="sales.monthly_target",
                impact="月度目标双源均为空，目标偏离与未来目标库存覆盖不可判",
                repair_action="由运营在 ERP 配置当月及未来三个月目标；源头未配置不阻断其它巡检",
                blocking=False,
                source_tool=TOOL_NAMES["monthly_goal"],
            ))

        children = (normalized.get("identity") or {}).get("children") or []
        pending_category_children = [
            child.get("child_asin")
            for child in children
            if (child.get("frontend") or {}).get("category_name")
            and (child.get("category_baseline") or {}).get("status") != "CONFIRMED"
        ]
        if pending_category_children:
            gaps.append(DataGap(
                code="CATEGORY_BASELINE_PENDING_CONFIRMATION",
                field="identity.children[].category_baseline",
                impact=(
                    f"{len(pending_category_children)} 个子体的首次类目基准未确认，"
                    "类目异常本轮未判定"
                ),
                repair_action="运营确认首次观察类目基准后重跑巡检",
                blocking=False,
                source_tool="erp_listing_price_promotion_analysis",
            ))

        if sales.get("freshness") == "STALE":
            gaps.append(DataGap(
                code="SALES_DATA_STALE",
                field="sales.latest_stat_date",
                impact=(
                    f"销量数据已过期 {sales.get('data_age_days')} 天，"
                    "销量、目标偏离、ACOS 等依赖时序的判定不可信"
                ),
                repair_action="检查 ERP 毛利历史同步任务，补齐最近日期后重跑巡检",
                blocking=False,
                source_tool=TOOL_NAMES["gross_profit"],
            ))

        effective_days = sales.get("effective_days") or 0
        if 0 < effective_days < self.sales_min_effective_days:
            gaps.append(DataGap(
                code="SALES_WINDOW_INSUFFICIENT",
                field="sales.effective_days",
                impact=f"有效销售天数仅 {effective_days} 天，滚动指标样本不足",
                repair_action="等待数据积累或延长取数窗口后重跑",
                blocking=False,
                source_tool=TOOL_NAMES["gross_profit"],
            ))

        if inventory.get("inventory_days_of_supply") is None:
            gaps.append(DataGap(
                code="INVENTORY_DAYS_MISSING",
                field="inventory.inventory_days_of_supply",
                impact="无法判断广告放量是否会导致断货，放量类动作不可批",
                repair_action="补齐 FBA 可售库存或 30 天日均销量后重跑",
                blocking=False,
                source_tool=TOOL_NAMES["stock"],
            ))

        if profit.get("target_acos") is None or profit.get("target_daily_budget") is None:
            gaps.append(DataGap(
                code="ADVERTISING_TARGET_CONFIG_MISSING",
                field="profit.target_acos/profit.target_daily_budget",
                impact="缺少目标 ACOS 或目标每日预算，广告类异常只能出配置待补提示",
                repair_action="在 ERP 补齐该经营单元的广告目标配置",
                blocking=False,
                source_tool=TOOL_NAMES["unit_profit"],
            ))

        if profit.get("best_feasible_net_cash_recovery") is None:
            gaps.append(DataGap(
                code="NET_CASH_RECOVERY_MISSING",
                field="profit.best_feasible_net_cash_recovery",
                impact="G2 现金可行性无证据，退出/清货类结论不可自动判定",
                repair_action="由成本 Ontology 提供可复算的净现金回收快照",
                blocking=False,
                source_tool=TOOL_NAMES["unit_profit"],
            ))

        disabled_fact_keys = frozenset(
            (normalized.get("_meta") or {}).get("disabled_fact_keys") or []
        )
        if (
            "natural_ad_flow" not in disabled_fact_keys
            and not traffic.get("daily_series")
        ):
            gaps.append(DataGap(
                code="TRAFFIC_DAILY_SERIES_UNAVAILABLE",
                field="traffic.daily_series",
                impact=(
                    "自然/广告流量工具只返回窗口聚合和子体明细，且毛利逐日数据"
                    "无法安全推导自然订单序列，不能据此判断连续多日趋势"
                ),
                repair_action=(
                    "补齐同口径的逐日总订单与广告订单，或要求 ERP 提供专用趋势工具"
                ),
                blocking=False,
                source_tool=TOOL_NAMES["natural_ad_flow"],
            ))

        unresolved = (normalized.get("_meta") or {}).get("unresolved_fields") or []
        if unresolved:
            gaps.append(DataGap(
                code="FIELD_MAPPING_UNRESOLVED",
                field=",".join(unresolved[:10]),
                impact=f"{len(unresolved)} 个字段在 MCP 响应中未找到任何候选键，已按缺失处理",
                repair_action="核对 ERP MCP 响应字段表并更新 facts/normalizer.py 候选键",
                blocking=False,
            ))

        return gaps

    # -- 身份 --------------------------------------------------------------
    def _identity_gaps(
        self,
        unit: OperatingUnitBinding,
        normalized: dict[str, Any],
    ) -> list[DataGap]:
        identity = normalized.get("identity", {})
        gaps: list[DataGap] = []

        if not identity.get("children"):
            gaps.append(DataGap(
                code="IDENTITY_REQUIRED",
                field="identity.children",
                impact="没有任何子体记录，无法定位子体例外，也不得进入事件池",
                repair_action="确认父 ASIN 与父 SKU 绑定关系，重新采集 product_info",
                blocking=True,
                source_tool=TOOL_NAMES["product_info"],
            ))
            return gaps

        # 跨父体挂接：子体的 parentAsin 与当前经营单元不一致 → 身份存疑，不静默合并。
        mismatched = [
            child["child_asin"]
            for child in identity["children"]
            if child.get("parent_asin") and child["parent_asin"] != unit.parent_asin
        ]
        if mismatched:
            gaps.append(DataGap(
                code="IDENTITY_AMBIGUOUS",
                field="identity.children[].parent_asin",
                impact=(
                    f"{len(mismatched)} 个子体挂在其它父体下（{', '.join(mismatched[:5])}），"
                    "证据不得跨经营单元合并"
                ),
                repair_action="人工核对变体关系后再判定，不得按 ASIN 兜底",
                blocking=False,
                source_tool=TOOL_NAMES["product_info"],
            ))
        return gaps

    # -- 汇总 --------------------------------------------------------------
    @staticmethod
    def summarize(gaps: list[DataGap]) -> tuple[DataQualityStatus, float]:
        """由缺口清单推导整体质量状态与完整度。

        完整度 = 1 - 0.15×阻断缺口 - 0.05×非阻断缺口，下限 0。
        阻断缺口权重更高，保证"有阻断"时完整度显著偏低，便于监控告警。
        """
        blocking = sum(1 for gap in gaps if gap.blocking)
        non_blocking = len(gaps) - blocking

        score = max(0.0, round(1.0 - blocking * 0.15 - non_blocking * 0.05, 4))
        if blocking:
            status = DataQualityStatus.INSUFFICIENT
        elif gaps:
            status = DataQualityStatus.PARTIAL
        else:
            status = DataQualityStatus.COMPLETE
        return status, score


def _dedupe(gaps: list[DataGap]) -> list[DataGap]:
    """同 code+field 只保留一条，blocking 优先。"""
    keyed: dict[tuple[str, str], DataGap] = {}
    for gap in gaps:
        key = (gap.code, gap.field)
        existing = keyed.get(key)
        if existing is None or (gap.blocking and not existing.blocking):
            keyed[key] = gap
    return sorted(keyed.values(), key=lambda g: (not g.blocking, g.code))
