from __future__ import annotations

from typing import Any

from clients.azlisting_contract import AZLISTING_FACT_CONTRACTS
from clients.mcp_client import McpToolResult
from core.errors import McpContractInvalid
from core.operating_unit import OperatingUnitBinding, canonical_site_code


def _child_asin(value: Any) -> str:
    return str(value or "").strip().upper()


def is_amazon_found_mirror(value: Any, real_child_asins: set[str]) -> bool:
    child_asin = _child_asin(value)
    return (
        child_asin.startswith("AMAZON.FOUND.")
        and child_asin.removeprefix("AMAZON.FOUND.") in real_child_asins
    )


def is_amazon_found_row(row: dict[str, Any], real_child_asins: set[str]) -> bool:
    return is_amazon_found_mirror(
        row.get("asin") or row.get("ASIN"), real_child_asins
    ) or is_amazon_found_mirror(
        row.get("sellerSku") or row.get("SELLER_SKU"), real_child_asins
    )


SELLABLE_PRODUCT_STATUSES = frozenset({"可售", "在售", "正常", "在售中"})
NO_CHILD_WARNINGS = frozenset({"未找到该父 ASIN 下的子体数据"})


def is_no_child_placeholder(row: dict[str, Any]) -> bool:
    return (
        not _child_asin(row.get("asin") or row.get("ASIN"))
        and not str(row.get("sellerSku") or row.get("SELLER_SKU") or "").strip()
        and str(row.get("childWarn") or "").strip() in NO_CHILD_WARNINGS
    )


def is_obsolete_product_duplicate(row: dict[str, Any], rows: list[dict[str, Any]]) -> bool:
    child_asin = _child_asin(row.get("asin") or row.get("ASIN"))
    if not child_asin or child_asin.startswith("AMAZON.FOUND."):
        return False
    status = str(row.get("status") or "").strip()
    if status in SELLABLE_PRODUCT_STATUSES:
        return False
    return any(
        _child_asin(candidate.get("asin") or candidate.get("ASIN")) == child_asin
        and str(candidate.get("status") or "").strip() in SELLABLE_PRODUCT_STATUSES
        for candidate in rows
    )


def _nested_objects(value: Any):
    if isinstance(value, dict):
        yield value
        for nested in value.values():
            yield from _nested_objects(nested)
    elif isinstance(value, list):
        for nested in value:
            yield from _nested_objects(nested)


def fact_contract_errors(
    unit: OperatingUnitBinding,
    raw: dict[str, McpToolResult | Exception],
) -> list[str]:
    errors: set[str] = set()
    for key, contract in AZLISTING_FACT_CONTRACTS.items():
        result = raw.get(key)
        if not isinstance(result, McpToolResult):
            continue
        if result.tool_name != contract.tool_name:
            errors.add(f"FACT_TOOL_MISMATCH:{key}")
            continue
        if any(not isinstance(row, dict) for row in result.data):
            errors.add(f"FACT_ROW_INVALID:{contract.tool_name}")
            continue

        nested_rows = list(_nested_objects(result.data))
        no_child_response = key == "product_info" and bool(result.data) and all(
            is_no_child_placeholder(row) for row in result.data
        )
        for group_index, candidates in enumerate(contract.fact_field_groups):
            if contract.critical and result.data and not no_child_response and not any(
                candidate in row
                for row in nested_rows
                for candidate in candidates
            ):
                errors.add(f"FACT_FIELDS_MISSING:{contract.tool_name}:{group_index}")

        if key == "product_info":
            child_skus: dict[str, str] = {}
            real_child_asins = {
                _child_asin(row.get("asin") or row.get("ASIN"))
                for row in result.data
                if _child_asin(row.get("asin") or row.get("ASIN"))
                and not _child_asin(row.get("asin") or row.get("ASIN")).startswith(
                    "AMAZON.FOUND."
                )
            }
            for index, row in enumerate(result.data):
                parent_asin = str(row.get("parentAsin") or "").strip().upper()
                if not parent_asin:
                    errors.add(f"PRODUCT_PARENT_IDENTITY_MISSING:{index}")
                elif parent_asin != unit.parent_asin:
                    errors.add(f"PRODUCT_PARENT_IDENTITY_MISMATCH:{index}")
                child_asin = str(row.get("asin") or row.get("ASIN") or "").strip().upper()
                if not child_asin:
                    if is_no_child_placeholder(row):
                        continue
                    errors.add(f"PRODUCT_CHILD_ASIN_MISSING:{index}")
                    continue
                if is_amazon_found_row(row, real_child_asins):
                    continue
                if is_obsolete_product_duplicate(row, result.data):
                    continue
                seller_sku = str(
                    row.get("sellerSku") or row.get("SELLER_SKU") or ""
                ).strip()
                if child_asin in child_skus:
                    errors.add(f"PRODUCT_CHILD_ASIN_DUPLICATE:{child_asin}")
                    if seller_sku != child_skus[child_asin]:
                        errors.add(f"PRODUCT_CHILD_SKU_CONFLICT:{child_asin}")
                else:
                    child_skus[child_asin] = seller_sku

        if key == "listing_identity" and result.data:
            if len(result.data) != 1:
                errors.add("LISTING_IDENTITY_ROW_COUNT_INVALID")
            listing_asin = str(result.data[0].get("asin") or "").strip().upper()
            if not listing_asin:
                errors.add("LISTING_PARENT_IDENTITY_MISSING")
            elif listing_asin != unit.parent_asin:
                errors.add("LISTING_PARENT_IDENTITY_MISMATCH")

        for row in nested_rows:
            if "parentAsin" in row:
                actual = str(row.get("parentAsin") or "").strip().upper()
                if actual and actual != unit.parent_asin:
                    errors.add(f"FACT_PARENT_ASIN_MISMATCH:{contract.tool_name}")
            if "parentSellerSku" in row:
                actual = str(row.get("parentSellerSku") or "").strip()
                if actual and actual != unit.parent_seller_sku:
                    errors.add(f"FACT_PARENT_SKU_MISMATCH:{contract.tool_name}")
            if "shopId" in row or "SHOP_ID" in row:
                try:
                    actual_shop_id = int(row.get("shopId", row.get("SHOP_ID")))
                except (TypeError, ValueError):
                    errors.add(f"FACT_SHOP_ID_INVALID:{contract.tool_name}")
                else:
                    if actual_shop_id != unit.shop_id:
                        errors.add(f"FACT_SHOP_ID_MISMATCH:{contract.tool_name}")
            if any(key in row for key in ("siteCode", "PL_SITE_CODE", "plSiteCode")):
                actual = canonical_site_code(
                    row.get("siteCode", row.get("PL_SITE_CODE", row.get("plSiteCode")))
                )
                if actual and actual != unit.site_code:
                    errors.add(f"FACT_SITE_CODE_MISMATCH:{contract.tool_name}")
            if "shopAccount" in row:
                actual = str(row.get("shopAccount") or "").strip()
                if actual and actual != unit.shop_account:
                    errors.add(f"FACT_SHOP_ACCOUNT_MISMATCH:{contract.tool_name}")
    return sorted(errors)


def require_fact_contract(
    unit: OperatingUnitBinding,
    raw: dict[str, McpToolResult | Exception],
) -> None:
    errors = fact_contract_errors(unit, raw)
    if errors:
        raise McpContractInvalid(";".join(errors))
