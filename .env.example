# =============================================================================
# 环境变量样例。复制为 .env 后填写真实值。
# =============================================================================
# 【安全铁律】
#   1. .env 不进版本库（已在 .gitignore）。
#   2. 令牌不写进 config/settings.yaml，YAML 里只放变量名。
#   3. 令牌不进日志、不进异常上下文、不进事实快照。
#   4. 生产环境优先用密钥中心注入，而不是文件。
# =============================================================================

# --- MCP：AZListing 是 V2 首选事实源 ---
AZLISTING_GATEWAY=http://mcp-gateway.example.com/mcp
MCP_API_KEY=
# 可选运行覆盖。大批量真实重采可临时使用 90/1/3，常规运行保持 YAML 默认值。
# AZLISTING_TIMEOUT_SECONDS=90
# AZLISTING_CONCURRENCY=1
# AZLISTING_MAX_ATTEMPTS=3
# 前台详情需要邮编的站点可显式配置；值会进入请求审计，不属于密钥。
# AZLISTING_STOREFRONT_ZIP_CODES_JSON={"AMAZON_FR":"75001"}
# 仅在 mcp.operating_unit_strategy=PRINCIPAL_FOLLOW_UP 时填写。
# 每项必须给出负责人和权威店铺身份；不得从旧 SQLite 生成运行配置。
# AZLISTING_PRINCIPAL_SCOPES_JSON=[{"principalName":"姓名","principalUserId":10001,"shopId":1001,"shopAccount":"account","siteCode":"Amazon_US"}]
# 旧变量仍兼容，但优先级低于上面两个变量：
# MCP_AZLISTING_URL=
# MCP_AZLISTING_TOKEN=

# --- 补充 MCP：默认不启用，不会自动接管 AZListing 失败请求 ---
MCP_SYNC_GATEWAY=http://mcp-gateway.example.com/mcp
# 负责人目录默认只遍历 FBA 销售角色；一般无需覆盖。
# OWNER_OPERATOR_ROLE=GROUP_FBASaler

# --- 纯巡检结果接收端（合同冻结前保持 feature flag=false）---
INSPECTION_RESULT_SINK_URL=http://control-center.example.internal/internal/v1/inspection-results
INSPECTION_RESULT_SINK_TOKEN=
INSPECTION_FEEDBACK_TOKEN=

# --- 中控交互：巡检主动提交结果到中控 MCP ---
CONTROL_CENTER_MCP_URL=https://mcp-gateway.example.com/opsloop/mcp
CONTROL_CENTER_MCP_TOKEN=

# --- 经营模式 Agent：未命中时自动评估并复查，不调用 evaluate_operating_mode ---
OPERATING_MODE_MCP_URL=http://10.0.0.0:8001/mcp
OPERATING_MODE_MCP_TOKEN=

# --- 中控调用巡检复盘 MCP；合同冻结前保持 false ---
REVIEW_MCP_ENABLED=false
REVIEW_MCP_PUBLIC_TOKEN=
REVIEW_MCP_HOST=127.0.0.1
REVIEW_MCP_PORT=8791
REVIEW_MCP_UPSTREAM_URL=http://127.0.0.1:8791/mcp

# --- 巡检私有 MySQL 运行态（SQLAlchemy URL，不使用 JDBC URL）---
# 当前内网测试 MySQL 与 JDBC `useSSL=false` 对齐；若生产启用 TLS，应改为证书校验配置。
PATROL_DATABASE_URL=mysql+pymysql://user:pass@db.example.internal:3306/app_database?charset=utf8mb4&ssl_disabled=true
