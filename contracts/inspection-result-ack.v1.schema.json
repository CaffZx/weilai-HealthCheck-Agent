{
  "$defs": {
    "RejectedObject": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "reason_code"
      ],
      "title": "RejectedObject",
      "type": "object"
    }
  },
  "$id": "https://schemas.amazon-ops.local/contracts/inspection-result-ack.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "结果接收端确认纯巡检结果已完成业务接收的 ACK",
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "accepted_object_ids": {
      "items": {
        "type": "string"
      },
      "title": "Accepted Object Ids",
      "type": "array"
    },
    "duplicate": {
      "title": "Duplicate",
      "type": "boolean"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "rejected_objects": {
      "items": {
        "$ref": "#/$defs/RejectedObject"
      },
      "title": "Rejected Objects",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "accepted",
    "duplicate",
    "received_at"
  ],
  "title": "InspectionResultAck",
  "type": "object"
}
