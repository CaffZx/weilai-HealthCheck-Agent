{
  "registry_version": "amazon_ops.market_tags.v1",
  "status": "ACTIVE_CONTROLLED",
  "authority": "MARKET_RELATION",
  "consumers": [
    "MARKET_RESEARCH",
    "BUSINESS_INSPECTION",
    "OPERATING_DECISION",
    "PRICE_PROMOTION",
    "INVENTORY_PLANNING",
    "LISTING_EXECUTION"
  ],
  "governance": {
    "one_authoritative_producer": true,
    "unknown_terms_become_candidates": true,
    "agent_may_publish_new_canonical_concept": false,
    "historical_profiles_are_immutable": true,
    "color_and_size_default_role": "FILTER_ONLY",
    "forbidden_inferences": [
      "tag_count_equals_relationship_strength",
      "keyword_equals_verified_product_attribute",
      "category_tree_node_equals_market_unit",
      "season_word_equals_observed_season_stage",
      "price_word_equals_current_price_position"
    ]
  },
  "namespaces": [
